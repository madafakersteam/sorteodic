<script>
/* ============ CONFIGURACIÓN ============ */
const API = 'https://script.google.com/macros/s/AKfycbzBtxYx59fpPFwAgVet2FgySWR-nGiMcRKge6gjV1JlwwWXOrW68Ipv6njyND-eId-a/exec';   // URL de la implementación web de Apps Script (termina en /exec)
const MONTO_POR_TICKET = 5000;
const FECHA_SORTEO = '2026-12-30T20:00:00-03:00';  // se usa si el servidor no responde
const NOMBRE_SORTEO = "Sorteo Fin de Año · Madafaker's Team";
/* ======================================= */

let CLAVE = '';           // clave de agentes
let CLAVE_S = '';         // clave del sorteo (solo en memoria)
let CFG = null;
let submitEnCurso = false;
let refrescoTimer = null;
let ultimoResultado = null;
const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = n => Number(n).toLocaleString('es-AR');

function toast(msg, err) {
  const t = document.createElement('div');
  t.className = 'toast' + (err ? ' err' : '');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3500);
}

const SESION_MS = 72 * 3600 * 1000;   // la sesión de agentes se cierra tras 72 h SIN actividad
function tocar() { try { localStorage.setItem('mf_t', String(Date.now())); } catch (e) {} }
async function api(params, clave) {
  const q = new URLSearchParams(params);
  if (clave !== false) q.set('clave', clave || CLAVE);
  q.set('_', Date.now());
  if (CLAVE) tocar();
  const r = await fetch(API + '?' + q.toString());
  const j = await r.json();
  return j;
}

let fin = new Date(FECHA_SORTEO).getTime();
const p2 = n => String(n).padStart(2, '0');
const n4 = n => String(n).padStart(4, '0');   // los números se muestran siempre con 4 dígitos mínimo (0001)
function tick() {
  const d = fin - Date.now();
  if (d <= 0) {
    $('cdTitulo').textContent = '🎉 ¡Llegó el momento del sorteo!';
    $('cd').innerHTML = '<div class="done" style="grid-column:1/-1">🎄 ¡Feliz fin de año! 🎄</div>';
    $('when').classList.add('hidden');
    clearInterval(tm); return;
  }
  const s = Math.floor(d / 1000);
  $('cdD').textContent = p2(Math.floor(s / 86400));
  $('cdH').textContent = p2(Math.floor(s % 86400 / 3600));
  $('cdM').textContent = p2(Math.floor(s % 3600 / 60));
  $('cdS').textContent = p2(s % 60);
}
tick(); const tm = setInterval(tick, 1000);


/* ---------- login ---------- */
function mostrarLogin(msg) {
  $('app').classList.add('hidden');
  $('login').classList.remove('hidden');
  $('loginMsg').textContent = msg || '';
}
async function entrar(clave) {
  $('btnLogin').disabled = true;
  try {
    const r = await api({ action: 'recent' }, clave);
    if (r && r.error === 'clave') { mostrarLogin('Clave incorrecta'); try { localStorage.removeItem('mf_clave'); localStorage.removeItem('mf_t'); } catch (e) {} return; }
    if (r && r.error) { mostrarLogin(r.error); return; }
    CLAVE = clave;
    try { localStorage.setItem('mf_clave', clave); } catch (e) {}
    tocar();
    $('login').classList.add('hidden');
    $('app').classList.remove('hidden');
    iniciar();
  } catch (e) {
    mostrarLogin('No se pudo conectar. Revisá tu internet.');
  } finally { $('btnLogin').disabled = false; }
}
$('btnLogin').onclick = () => { const v = $('claveIn').value.trim(); if (v) entrar(v); };
$('claveIn').addEventListener('keydown', e => { if (e.key === 'Enter') $('btnLogin').click(); });

/* ---------- inicio ---------- */
async function iniciar() {
  try { CFG = await api({ action: 'config' }, false); } catch (e) { CFG = null; }
  if (CFG && CFG.fechaSorteo) { fin = new Date(CFG.fechaSorteo).getTime(); tick(); }
  if (CFG && CFG.cerrado) {
    $('subtitulo').textContent = 'Registro cerrado · ya no se pueden cargar números';
    $('btnAdd').disabled = true;
  }
  cargarStats();
  clearInterval(refrescoTimer);
  refrescoTimer = setInterval(() => {
    if (document.hidden) return;
    cargarStats();
    if (!$('t-lista').classList.contains('hidden')) cargarLista();
    if (CLAVE_S && !$('t-sorteo').classList.contains('hidden')) cargarHist();
  }, 25000);
}
async function cargarStats() {
  try {
    const s = await api({ action: 'stats' }, false);
    if (s && s.total != null) { $('sTotal').textContent = fmt(s.total); $('sHoy').textContent = fmt(s.hoy); }
  } catch (e) {}
}

/* ---------- pestañas ---------- */
document.querySelectorAll('.tab').forEach(b => b.onclick = () => {
  document.querySelectorAll('.tab').forEach(x => x.classList.toggle('on', x === b));
  ['cargar', 'lista', 'buscar', 'sorteo'].forEach(t => $('t-' + t).classList.toggle('hidden', t !== b.dataset.t));
  if (b.dataset.t === 'lista') cargarLista();
  if (b.dataset.t === 'sorteo' && CLAVE_S) cargarHist();
});

/* ---------- tarjetas ---------- */
const ICON_SHARE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>';
function tarjetaHTML(c, conShare, idx, hl) {
  return '<div class="ticket-wrap"><div class="ticket"><div class="nm">' + esc(c.nombre) + '<span class="us">@' + esc(c.usuario) + '</span></div>' +
    '<div class="meta">' + esc(c.fecha) + ' · ' + esc(c.hora) + ' · $' + fmt(c.monto) + '</div>' +
    '<div class="nums">' + c.numeros.map(n => '<span class="num' + (hl && String(n) === hl ? ' hit' : '') + '">' + n4(n) + '</span>').join('') + '</div></div>' +
    (conShare ? '<button class="share" data-i="' + idx + '" title="Compartir" aria-label="Compartir">' + ICON_SHARE + '</button>' : '') + '</div>';
}
let listaActual = [];
function pintarCompras(box, compras, hl) {
  listaActual = compras;
  if (!compras.length) { box.innerHTML = '<div class="empty">Sin resultados</div>'; return; }
  box.innerHTML = compras.map((c, i) => tarjetaHTML(c, true, i, hl)).join('');
  box.querySelectorAll('.share').forEach(b => b.onclick = () => compartir(listaActual[+b.dataset.i]));
}

async function cargarLista() {
  try {
    const r = await api({ action: 'recent' });
    if (r && r.error) { $('listaBox').innerHTML = '<div class="empty">' + esc(r.error) + '</div>'; return; }
    if (!r.length) { $('listaBox').innerHTML = '<div class="empty">Todavía no hay cargas</div>'; return; }
    pintarCompras($('listaBox'), r);
  } catch (e) { $('listaBox').innerHTML = '<div class="empty">No se pudo cargar</div>'; }
}
async function cargarHist() {
  try {
    const r = await api({ action: 'historial' }, CLAVE_S);
    if (r && r.error) { $('histBox').innerHTML = '<div class="empty">' + esc(r.error) + '</div>'; return; }
    $('histBox').innerHTML = (r && r.length) ? r.map(d => '<div class="row"><span>' + esc(d.fecha) + '</span><b>' + fmt(d.cantidad) + ' números</b></div>').join('') : '<div class="empty">Sin datos</div>';
  } catch (e) {}
}

/* ---------- buscar ---------- */
$('btnBuscar').onclick = async () => {
  const q = $('qIn').value.trim();
  if (!q) return;
  $('buscarBox').innerHTML = '<div class="empty">Buscando…</div>';
  try {
    const r = await api({ action: 'search', q });
    if (r && r.error) { $('buscarBox').innerHTML = '<div class="empty">' + esc(r.error) + '</div>'; return; }
    const solo = q.replace(/[.\s]/g, '');
    pintarCompras($('buscarBox'), r, /^\d+$/.test(solo) ? String(parseInt(solo, 10)) : '');
  } catch (e) { $('buscarBox').innerHTML = '<div class="empty">No se pudo buscar</div>'; }
};
$('qIn').addEventListener('keydown', e => { if (e.key === 'Enter') $('btnBuscar').click(); });

/* ---------- cargar ticket ---------- */
$('fMonto').addEventListener('input', () => {
  const m = parseInt($('fMonto').value.replace(/\D/g, ''), 10) || 0;
  const n = Math.floor(m / MONTO_POR_TICKET);
  $('hintMonto').textContent = m ? (n >= 1 ? '→ le corresponden ' + n + (n === 1 ? ' número' : ' números') : 'Mínimo $' + fmt(MONTO_POR_TICKET) + ' para recibir un número') : '';
});

function nuevoRid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }
let ridActual = null;

$('btnAdd').onclick = async () => {
  if (submitEnCurso) return;
  const nombre = $('fNombre').value.trim(), usuario = $('fUsuario').value.trim();
  const monto = parseInt($('fMonto').value.replace(/\D/g, ''), 10) || 0;
  if (!nombre || !usuario) return toast('Completá nombre y usuario', true);
  const n = Math.floor(monto / MONTO_POR_TICKET);
  if (n < 1) return toast('El monto mínimo es $' + fmt(MONTO_POR_TICKET), true);
  if (!ridActual) ridActual = nuevoRid();   // si hay reintento tras un error de red, se reusa y no duplica
  submitEnCurso = true;
  const btn = $('btnAdd');
  btn.disabled = true; btn.textContent = 'GENERANDO…';
  try {
    const r = await api({ action: 'add', nombre, usuario, monto, rid: ridActual });
    if (r.error) { toast(r.error, true); if (r.error === 'clave') mostrarLogin('Clave incorrecta'); return; }
    ridActual = null;
    ultimoResultado = r;
    $('resultado').innerHTML = tarjetaHTML(r, true, 0);
    $('resultado').querySelector('.share').onclick = () => compartir(ultimoResultado);
    $('fNombre').value = ''; $('fUsuario').value = ''; $('fMonto').value = ''; $('hintMonto').textContent = '';
    cargarStats();
    toast('✅ Ticket generado: ' + r.numeros.length + (r.numeros.length === 1 ? ' número' : ' números'));
  } catch (e) {
    toast('Sin conexión. Tocá de nuevo para reintentar (no se duplica).', true);
  } finally {
    submitEnCurso = false;
    btn.textContent = 'GENERAR TICKET';
    btn.disabled = !!(CFG && CFG.cerrado);
  }
};

/* ---------- compartir como PNG ---------- */
function rrect(ctx, x, y, w, h, r) {
  ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
}
function fitText(ctx, text, maxW, size, weight, family) {
  let s = size;
  do { ctx.font = weight + ' ' + s + 'px ' + family; s -= 2; } while (ctx.measureText(text).width > maxW && s > 18);
}
function dibujarTicket(c) {
  const nums = c.numeros, n = nums.length, PAD = 36;
  const SANS = 'Inter, Arial, sans-serif', MONO = '"Space Mono", monospace';
  const m = document.createElement('canvas').getContext('2d');
  // chips uniformes
  const CH = 44, GAP = 8, CF = 26;
  m.font = '700 ' + CF + 'px ' + MONO;
  const CW = Math.ceil(m.measureText('0000').width) + 26;      // cuadradito de tamaño fijo (4 dígitos)
  const maxDig = Math.max.apply(null, nums.map(v => n4(v).length));
  const CFN = maxDig <= 4 ? CF : Math.floor(CF * 4 / maxDig) + (maxDig === 5 ? 1 : 0);   // 5+ dígitos: letra apenas más chica, mismo cuadradito
  const VGAP = 6;                                              // separación vertical mínima entre filas
  // filas: hasta 3, lo más angosto posible
  const PER = 7;                                  // siempre hasta 7 por fila
  const filas = []; for (let i = 0; i < n; i += PER) filas.push(nums.slice(i, i + PER));
  const W = PER * CW + (PER - 1) * GAP + PAD * 2;  // ANCHO FIJO para todos los tickets
  const maxW = W - PAD * 2;

  // nombre grande: una línea o, si es muy largo, dos
  const nombre = String(c.nombre);
  let sz = 60; m.font = '800 ' + sz + 'px ' + SANS;
  while (m.measureText(nombre).width > maxW && sz > 38) { sz -= 2; m.font = '800 ' + sz + 'px ' + SANS; }
  let lineas = [nombre];
  if (m.measureText(nombre).width > maxW) {
    const p = nombre.split(' '); let best = null;
    for (let i = 1; i < p.length; i++) { const a = p.slice(0, i).join(' '), b = p.slice(i).join(' '); const d = Math.abs(a.length - b.length); if (!best || d < best.d) best = { a, b, d }; }
    if (best) lineas = [best.a, best.b];
    sz = 56; m.font = '800 ' + sz + 'px ' + SANS;
    while (lineas.some(t => m.measureText(t).width > maxW) && sz > 26) { sz -= 2; m.font = '800 ' + sz + 'px ' + SANS; }
  }
  const usz = Math.max(18, Math.round(sz / 3.4));          // usuario: ~3 a 4 veces más chico que el nombre
  const pie1 = "MADAFAKER'S TEAM · SORTEO FIN DE AÑO", dd = new Date(FECHA_SORTEO), tz = { timeZone: 'America/Argentina/Buenos_Aires' };
  const fecha = dd.toLocaleDateString('es-AR', Object.assign({ day: 'numeric', month: 'long' }, tz)) + ' · ' + dd.toLocaleTimeString('es-AR', Object.assign({ hour: '2-digit', minute: '2-digit', hour12: false }, tz)) + ' hs';
  m.font = '700 17px ' + SANS;
  const pieUna = m.measureText(pie1 + ' · Sorteo: ' + fecha).width <= maxW;
  const H = 28 + lineas.length * (sz + 4) + 10 + usz + 14 + filas.length * (CH + VGAP) - VGAP + 16 + (pieUna ? 46 : 68);
  const cv = document.createElement('canvas'); cv.width = W; cv.height = H;
  const ctx = cv.getContext('2d');

  let g = ctx.createLinearGradient(0, 0, 0, H); g.addColorStop(0, '#220509'); g.addColorStop(1, '#0a0a0a');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  for (let i = 0; i < 26; i++) { ctx.fillStyle = 'rgba(255,255,255,' + (0.16 + (i % 4) * 0.1) + ')'; ctx.beginPath(); ctx.arc((i * 277 + 30) % W, (i * 131 + 20) % H, 1.3 + (i % 3), 0, 7); ctx.fill(); }
  ctx.lineWidth = 5; ctx.strokeStyle = '#D0102A'; ctx.beginPath(); ctx.roundRect(2.5, 2.5, W - 5, H - 5, 24); ctx.stroke();
  const cols = ['#ff2a44', '#ffd24d', '#35d07a', '#ffffff'];
  const nl = Math.max(8, Math.round(W / 70));
  for (let i = 0; i < nl; i++) { const x = 34 + i * ((W - 68) / (nl - 1)); ctx.fillStyle = cols[i % 4]; ctx.beginPath(); ctx.arc(x, 18, 5, 0, 7); ctx.fill(); }

  ctx.textAlign = 'center'; let y = 28;
  // nombre del cliente: grande y blanco
  ctx.fillStyle = '#fff'; ctx.font = '800 ' + sz + 'px ' + SANS;
  lineas.forEach(t => { y += sz; ctx.fillText(t, W / 2, y - 4); y += 4; });
  // usuario: chico y rojo, justo arriba de los números
  y += 10 + usz;
  const cuando = '  ·  ' + c.fecha + '  ' + String(c.hora).slice(0, 5);
  let fz = usz, ut = '@' + c.usuario, wU, wC;
  const medir = () => { ctx.font = '700 ' + fz + 'px ' + MONO; wU = ctx.measureText(ut).width; wC = ctx.measureText(cuando).width; };
  medir();
  while (wU + wC > maxW && fz > 15) { fz -= 1; medir(); }
  while (wU + wC > maxW && ut.length > 6) { ut = ut.slice(0, -2) + '…'; medir(); }
  const x0 = (W - (wU + wC)) / 2;
  ctx.textAlign = 'left';
  ctx.fillStyle = '#FF3B4E'; ctx.fillText(ut, x0, y - 3);          // usuario en rojo
  ctx.fillStyle = '#e8e8e8'; ctx.fillText(cuando, x0 + wU, y - 3);  // fecha y hora al lado
  ctx.textAlign = 'center';
  y += 10;
  // números
  filas.forEach(f => {
    const tot = f.length * CW + (f.length - 1) * GAP; let x = (W - tot) / 2;
    f.forEach(v => {
      const bg = ctx.createLinearGradient(0, y, 0, y + CH); bg.addColorStop(0, '#ee2a44'); bg.addColorStop(1, '#a30c20');
      ctx.fillStyle = bg; ctx.beginPath(); ctx.roundRect(x, y, CW, CH, 10); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,.2)'; ctx.beginPath(); ctx.roundRect(x + 3, y + 3, CW - 6, CH / 2 - 3, 8); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.font = '700 ' + CFN + 'px ' + MONO; ctx.textBaseline = 'middle'; ctx.fillText(n4(v), x + CW / 2, y + CH / 2 + 2); ctx.textBaseline = 'alphabetic';
      x += CW + GAP;
    });
    y += CH + VGAP;
  });
  y -= VGAP;
  // pie chico, blanco
  y += 16; ctx.strokeStyle = 'rgba(255,255,255,.25)'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(PAD, y); ctx.lineTo(W - PAD, y); ctx.stroke();
  ctx.fillStyle = '#fff';
  if (pieUna) { ctx.font = '700 17px ' + SANS; ctx.fillText(pie1 + ' · Sorteo: ' + fecha, W / 2, y + 30); }
  else { ctx.font = '800 18px ' + SANS; ctx.fillText(pie1, W / 2, y + 28); ctx.font = '600 17px ' + SANS; ctx.fillText('Sorteo: ' + fecha, W / 2, y + 52); }
  return cv;
}
async function compartir(c) {
  try {
    if (document.fonts && document.fonts.load) { try { await Promise.all([document.fonts.load('700 100px "Mountains of Christmas"'), document.fonts.load('700 40px "Space Mono"'), document.fonts.load('800 30px Inter')]); } catch (e) {} }
    const cv = dibujarTicket(c);
    const blob = await new Promise(res => cv.toBlob(res, 'image/png'));
    const file = new File([blob], 'ticket-' + c.numeros[0] + '.png', { type: 'image/png' });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ files: [file], title: NOMBRE_SORTEO, text: '🎄 Tus números del sorteo: ' + c.numeros.map(n4).join(', ') });
    } else {
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = file.name;
      document.body.appendChild(a); a.click(); a.remove();
      toast('Tu navegador no permite compartir directo: se descargó la imagen');
    }
  } catch (e) {
    if (e && e.name === 'AbortError') return;
    toast('No se pudo compartir', true);
  }
}

/* ---------- sorteo ---------- */
let ganadores = [];
$('btnSorteoEntrar').onclick = async () => {
  const v = $('claveSorteoIn').value.trim();
  if (!v) return;
  $('btnSorteoEntrar').disabled = true;
  try {
    const r = await api({ action: 'ganadores' }, v);
    if (r.error) { $('sorteoMsg').textContent = r.error === 'clave' ? 'Clave incorrecta' : r.error; return; }
    CLAVE_S = v;
    $('sorteoLock').classList.add('hidden');
    $('sorteoPanel').classList.remove('hidden');
    pintarGanadores(r);
    cargarHist();
  } catch (e) { $('sorteoMsg').textContent = 'No se pudo conectar'; }
  finally { $('btnSorteoEntrar').disabled = false; }
};
function pintarGanadores(r) {
  ganadores = r.lista || [];
  $('winList').innerHTML = ganadores.length ? ganadores.map(g =>
    '<div class="win' + (g.tipo === 'suplente' ? ' sup' : '') + '"><span><b>' + esc(g.premio) + '</b><br>' + esc(g.nombre) + ' · @' + esc(g.usuario) + '</span><b>#' + n4(g.numero) + '</b></div>').join('') : '<div class="empty">Todavía no se sorteó nada</div>';
  const total = ((CFG && CFG.premios) ? CFG.premios.length : 4) + ((CFG && CFG.suplentes) || 0);
  $('btnSortear').disabled = ganadores.length >= total;
  $('btnSortear').textContent = ganadores.length >= total ? 'SORTEO COMPLETO' : (ganadores.length < ((CFG && CFG.premios) ? CFG.premios.length : 4) ? 'SORTEAR ' + (CFG && CFG.premios ? CFG.premios[ganadores.length].toUpperCase() : 'PREMIO') : 'SORTEAR SUPLENTE');
  $('pubEstado').textContent = r.publicado ? '✅ Los ganadores ya están visibles en la web pública' : 'Los ganadores todavía NO se muestran en la web pública';
  $('btnPublicar').textContent = r.publicado ? '🙈 Ocultar ganadores de la web' : '📢 Publicar ganadores en la web';
  $('btnPublicar').dataset.pub = r.publicado ? '1' : '0';
}
function modal(html) {
  const h = $('modalHost');
  h.innerHTML = '<div class="modal"><div class="mbox">' + html + '<button class="btn" id="mCerrar">CONTINUAR</button></div></div>';
  $('mCerrar').onclick = () => { h.innerHTML = ''; };
}
let sorteando = false;
$('btnSortear').onclick = async () => {
  if (sorteando) return;
  const orden = ganadores.length + 1;
  sorteando = true; $('btnSortear').disabled = true;
  try {
    const g = await api({ action: 'sortear', orden }, CLAVE_S);
    if (g.error) { toast(g.error, true); return; }
    modal('<div class="pr">' + esc(g.premio) + '</div><div class="big">#' + n4(g.numero) + '</div><div class="who">' + esc(g.nombre) + '</div><div class="un">@' + esc(g.usuario) + '</div>');
    const r = await api({ action: 'ganadores' }, CLAVE_S);
    if (!r.error) pintarGanadores(r);
  } catch (e) { toast('Error de conexión, reintentá', true); }
  finally { sorteando = false; if (ganadores.length) $('btnSortear').disabled = $('btnSortear').textContent === 'SORTEO COMPLETO'; else $('btnSortear').disabled = false; }
};
$('btnPublicar').onclick = async () => {
  const quiere = $('btnPublicar').dataset.pub === '1' ? '0' : '1';
  if (quiere === '1' && !confirm('¿Publicar los ganadores en la página pública?')) return;
  try {
    await api({ action: 'publicar', valor: quiere }, CLAVE_S);
    const r = await api({ action: 'ganadores' }, CLAVE_S);
    if (!r.error) pintarGanadores(r);
  } catch (e) { toast('No se pudo cambiar', true); }
};


/* nieve liviana: pocos copos, 30 cuadros por segundo, se detiene si la pestaña está oculta */
(function () {
  const cv = $('snow'), ctx = cv.getContext('2d'); let W, H, fl = [], last = 0;
  function size() { W = cv.width = innerWidth; H = cv.height = innerHeight; }
  size(); addEventListener('resize', size);
  const n = innerWidth < 600 ? 38 : 70;
  for (let i = 0; i < n; i++) fl.push({ x: Math.random() * 2000, y: Math.random() * 1200, r: 1 + Math.random() * 2.8, s: .5 + Math.random() * 1.1, d: Math.random() * 6 });
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  (function loop(t) {
    requestAnimationFrame(loop);
    if (t - last < 33) return; last = t;
    ctx.clearRect(0, 0, W, H); ctx.fillStyle = 'rgba(255,255,255,.8)'; ctx.beginPath();
    fl.forEach(f => { f.y += f.s; f.d += .02; f.x += Math.sin(f.d) * .7; if (f.y > H + 6) { f.y = -6; f.x = Math.random() * W; }
      const x = ((f.x % W) + W) % W; ctx.moveTo(x + f.r, f.y); ctx.arc(x, f.y, f.r, 0, 7); });
    ctx.fill();
  })(0);
})();
(function () { let h = ''; const n = innerWidth < 500 ? 12 : 22; for (let i = 0; i < n; i++) h += '<i></i>'; $('bulbs').innerHTML = h; })();

/* ---------- cerrar sesión / panel ---------- */
$('btnSalir').onclick = () => {
  if (!confirm('¿Cerrar la sesión en este dispositivo? Va a pedir la clave de nuevo.')) return;
  try { localStorage.removeItem('mf_clave'); localStorage.removeItem('mf_t'); } catch (e) {}
  location.reload();
};
$('btnSalirAdmin').onclick = () => {
  CLAVE_S = '';
  $('claveSorteoIn').value = '';
  $('sorteoPanel').classList.add('hidden');
  $('sorteoLock').classList.remove('hidden');
  $('sorteoMsg').textContent = '';
};

/* ---------- arranque ---------- */
(function () {
  let g = '';
  try {
    g = localStorage.getItem('mf_clave') || '';
    const t = Number(localStorage.getItem('mf_t')) || 0;
    if (g && (!t || Date.now() - t > SESION_MS)) { g = ''; localStorage.removeItem('mf_clave'); localStorage.removeItem('mf_t'); }
  } catch (e) {}
  if (API.indexOf('PEGAR_AQUI') === 0) { mostrarLogin('Falta configurar la URL del script (API)'); return; }
  if (g) entrar(g); else mostrarLogin('');
})();
