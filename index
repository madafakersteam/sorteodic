te%28150,134%29 scale%280.7%29%22%3E%3Cpolygon points=%2220.0,3.0 24.4,14.9 37.1,15.4 27.1,23.3 30.6,35.6 20.0,28.5 9.4,35.6 12.9,23.3 2.9,15.4 15.6,14.9%22 fill=%22%23ffffff%22 stroke=%22%23fff3b0%22 stroke-width=%221.2%22 stroke-linejoin=%22round%22/%3E%3C/g%3E%3Cg transform=%22translate%28152,164%29 scale%280.55%29%22%3E%3Crect x=%2216%22 y=%222%22 width=%228%22 height=%226%22 rx=%221%22 fill=%22%23f5c542%22/%3E%3Ccircle cx=%2220%22 cy=%2224%22 r=%2215%22 fill=%22%231f9a55%22/%3E%3Cpath d=%22M6,22 Q20,32 34,22%22 fill=%22none%22 stroke=%22%23f5c542%22 stroke-width=%223%22/%3E%3Cellipse cx=%2214%22 cy=%2217%22 rx=%224%22 ry=%222.4%22 transform=%22rotate%28-35 14 17%29%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3C/g%3E%3Cg transform=%22translate%28168,72%29 scale%280.55%29%22 stroke=%22%23fff%22 stroke-width=%222.4%22 fill=%22none%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3E%3Cg transform=%22rotate%280 20 20%29%22%3E%3Cline x1=%2220%22 y1=%223%22 x2=%2220%22 y2=%2237%22 /%3E%3Cpolyline points=%2214,9 20,15 26,9%22/%3E%3Cpolyline points=%2215,3 20,8 25,3%22 opacity=%220%22/%3E%3C/g%3E%3Cg transform=%22rotate%2860 20 20%29%22%3E%3Cline x1=%2220%22 y1=%223%22 x2=%2220%22 y2=%2237%22 /%3E%3Cpolyline points=%2214,9 20,15 26,9%22/%3E%3Cpolyline points=%2215,3 20,8 25,3%22 opacity=%220%22/%3E%3C/g%3E%3Cg transform=%22rotate%28120 20 20%29%22%3E%3Cline x1=%2220%22 y1=%223%22 x2=%2220%22 y2=%2237%22 /%3E%3Cpolyline points=%2214,9 20,15 26,9%22/%3E%3Cpolyline points=%2215,3 20,8 25,3%22 opacity=%220%22/%3E%3C/g%3E%3C/g%3E%3Ccircle cx=%2275%22 cy=%2222%22 r=%222%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%22150%22 cy=%2262%22 r=%222.4%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%2218%22 cy=%2288%22 r=%222%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%2298%22 cy=%22128%22 r=%222.2%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%22182%22 cy=%22128%22 r=%222%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%22130%22 cy=%22190%22 r=%222%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%2252%22 cy=%22128%22 r=%221.6%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3Ccircle cx=%228%22 cy=%22128%22 r=%221.6%22 fill=%22%23fff%22 opacity=%22.7%22/%3E%3C/svg%3E");background-size:auto,96px 96px}
.cdcard h2,.cdcard .when{text-shadow:0 2px 6px #000,0 0 12px rgba(0,0,0,.8)}
.cdcard h2{color:#fff;text-align:center}

.stats{display:flex;gap:10px;margin-bottom:14px}
.stat{flex:1;background:rgba(22,22,22,.94);border:1px solid rgba(208,16,42,.6);border-radius:12px;padding:10px;text-align:center}
.stat b{display:block;font-family:'Space Mono',monospace;font-size:24px;color:var(--red-light)}
.stat small{color:var(--gray);font-size:11px}
.panel{background:rgba(22,22,22,.94);border:1px solid rgba(208,16,42,.45);border-radius:14px;padding:14px;margin-bottom:14px}
.panel h2{font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--gray);margin-bottom:10px}
label{display:block;font-size:12px;color:var(--gray);margin:8px 0 4px}
input{width:100%;background:#0f0f0f;border:1px solid var(--line);color:var(--white);padding:12px;border-radius:10px;font-size:16px;font-family:inherit}
input:focus{outline:none;border-color:var(--red)}
.btn{width:100%;margin-top:12px;background:var(--red);color:#fff;border:0;border-radius:10px;padding:14px;font-size:15px;font-weight:800;letter-spacing:.5px}
.btn:disabled{opacity:.5}
.btn.sec{background:#222;border:1px solid var(--line)}
.hint{font-size:12px;color:var(--gold);margin-top:6px;min-height:16px}
.tabs{display:flex;gap:6px;margin-bottom:12px}
.tab{flex:1;padding:10px 4px;background:#1b1b1b;border:1px solid var(--line);color:var(--gray);border-radius:10px;font-size:12px;font-weight:700}
.tab.on{background:var(--red);color:#fff;border-color:var(--red)}
.hidden{display:none!important}
.ticket-wrap{display:flex;gap:8px;align-items:center;margin-bottom:8px}
.ticket{flex:1;min-width:0;background:linear-gradient(135deg,#1c1c1c,#101010);border:1px solid rgba(208,16,42,.7);border-left:4px solid var(--red);border-radius:10px;padding:8px 10px}
.ticket .nm{font-weight:800;font-size:14px;line-height:1.25;word-break:break-word}
.ticket .us{color:var(--red-light);font-family:'Space Mono',monospace;font-size:11px;font-weight:700;margin-left:6px;white-space:nowrap}
.ticket .meta{color:var(--gray);font-size:10.5px;margin-top:2px}
.nums{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.num{background:linear-gradient(180deg,#ee2a44,#a30c20);color:#fff;font-family:'Space Mono',monospace;font-weight:700;padding:3px 7px;border-radius:6px;font-size:13px}
.num.hit{outline:2px solid var(--gold);outline-offset:1px;box-shadow:0 0 10px rgba(245,197,66,.7)}
.share{width:38px;height:38px;flex:none;border-radius:50%;border:1px solid rgba(208,16,42,.6);background:#1c1c1c;color:#fff;display:flex;align-items:center;justify-content:center;padding:0}
.share svg{width:18px;height:18px}
.share:active{background:var(--red)}
.empty{color:var(--gray);text-align:center;font-size:13px;padding:16px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#222;border:1px solid var(--red);padding:10px 16px;border-radius:10px;font-size:13px;z-index:99;max-width:90%}
.toast.err{background:#3a0b12}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.88);display:flex;align-items:center;justify-content:center;z-index:50;padding:18px}
.mbox{background:var(--card);border:2px solid var(--red);border-radius:18px;padding:22px;width:100%;max-width:420px;text-align:center}
.mbox .pr{color:var(--gold);font-weight:800;letter-spacing:1px;text-transform:uppercase;font-size:14px}
.mbox .big{font-family:'Space Mono',monospace;font-size:56px;color:var(--red-light);font-weight:700;margin:8px 0}
.mbox .who{font-size:18px;font-weight:800}
.mbox .un{color:var(--gray);font-family:'Space Mono',monospace}
.win{display:flex;justify-content:space-between;gap:8px;padding:10px;border-bottom:1px solid var(--line);font-size:14px}
.win b{color:var(--gold)}
.win.sup b{color:var(--gray)}
.row{display:flex;justify-content:space-between;padding:9px 2px;border-bottom:1px solid var(--line);font-size:14px}
/* guirnalda */
.garland{position:relative;z-index:3;height:74px;overflow:hidden}
.garland svg{position:absolute;left:0;top:0;width:100%;height:60px}
.bulbs{position:absolute;left:0;right:0;top:0;height:74px;display:flex;justify-content:space-around;padding:0 2px}
.bulbs i{display:block;width:14px;height:22px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:currentColor;box-shadow:0 0 14px 3px currentColor;animation:tw 1.6s infinite alternate;margin-top:18px;position:relative}
.bulbs i::before{content:"";position:absolute;top:-6px;left:3px;width:8px;height:7px;background:#333;border-radius:2px}
.bulbs i:nth-child(odd){margin-top:34px}
.bulbs i:nth-child(4n+1){color:#ff2a44}.bulbs i:nth-child(4n+2){color:#ffd24d;animation-delay:.4s}.bulbs i:nth-child(4n+3){color:#35d07a;animation-delay:.8s}.bulbs i:nth-child(4n){color:#fff;animation-delay:1.2s}
@keyframes tw{from{opacity:.35;transform:scale(.92)}to{opacity:1;transform:scale(1)}}

.title{margin:6px 0 8px;text-align:center}
h1{text-align:center;font-family:'Mountains of Christmas','Space Mono',cursive;line-height:.9;text-shadow:0 0 26px rgba(208,16,42,.55)}
h1 .s1{display:block;font-size:clamp(30px,8.5vw,46px);color:#35d07a;letter-spacing:3px;text-shadow:0 0 16px rgba(53,208,122,.45)}
h1 .s2{display:block;white-space:nowrap;font-size:clamp(60px,19vw,118px);color:#fff;margin-top:2px;text-shadow:0 0 28px rgba(255,255,255,.35),0 4px 0 rgba(208,16,42,.55)}
/* cronómetro: 4 cuadros grandes con patrón navideño translúcido */
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.gift{position:relative;text-align:center;padding:22px 2px 14px;border-radius:16px;border:2px solid var(--red-light);overflow:hidden;
  background:linear-gradient(180deg,rgba(14,20,16,.97),rgba(4,6,5,.98));
  box-shadow:0 6px 16px rgba(0,0,0,.55),0 0 14px rgba(255,59,78,.3),inset 0 1px 0 rgba(255,255,255,.12)}
.gift b{display:block;font-family:'Space Mono',monospace;font-size:clamp(34px,11.5vw,64px);line-height:1;color:#fff;text-shadow:0 0 14px rgba(255,255,255,.35),0 3px 8px rgba(0,0,0,.9)}
.gift small{display:block;margin-top:9px;font-size:clamp(9px,2.8vw,12px);font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#fff;text-shadow:0 2px 5px #000}
.when{text-shadow:0 2px 6px #000,0 0 12px rgba(0,0,0,.8)}
.counter{text-align:center}
.counter b{display:block;font-family:'Space Mono',monospace;font-size:38px;color:var(--red-light)}
.counter small{color:var(--gray);font-size:12px}
h2{font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#fff;margin-bottom:12px;text-align:center}
.card.consulta h2{color:#35d07a}

/* cronómetro: 4 cuadros grandes con patrón navideño translúcido */
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.gift{position:relative;text-align:center;padding:22px 2px 14px;border-radius:16px;border:2px solid var(--red-light);overflow:hidden;
  background:linear-gradient(180deg,rgba(14,20,16,.97),rgba(4,6,5,.98));
  box-shadow:0 6px 16px rgba(0,0,0,.55),0 0 14px rgba(255,59,78,.3),inset 0 1px 0 rgba(255,255,255,.12)}
.gift b{display:block;font-family:'Space Mono',monospace;font-size:clamp(34px,11.5vw,64px);line-height:1;color:#fff;text-shadow:0 0 14px rgba(255,255,255,.35),0 3px 8px rgba(0,0,0,.9)}
.gift small{display:block;margin-top:9px;font-size:clamp(9px,2.8vw,12px);font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#fff;text-shadow:0 2px 5px #000}
.when{text-align:center;color:#fff;font-weight:800;font-size:14px;margin-top:14px}
.done{text-align:center;font-family:'Mountains of Christmas',cursive;font-size:30px;color:var(--gold)}

/* pinos al pie */
.forest{position:fixed;left:0;right:0;bottom:0;height:120px;z-index:2;pointer-events:none}
.forest svg{width:100%;height:100%;display:block}
</style>
</head>
<body>
<canvas id="snow"></canvas>
<div class="garland">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,6 Q75,56 150,6 T300,6 T450,6 T600,6 T750,6 T900,6 T1050,6 T1200,6" fill="none" stroke="#0e5a30" stroke-width="7"/><path d="M0,6 Q75,56 150,6 T300,6 T450,6 T600,6 T750,6 T900,6 T1050,6 T1200,6" fill="none" stroke="#1f8a4c" stroke-width="3" stroke-dasharray="2 5"/></svg>
  <div class="bulbs" id="bulbs"></div>
</div>

<div class="page">

<!-- LOGIN AGENTES -->
<div id="login" class="hidden">
  <div class="brand">MADAFAKER'S TEAM</div>
  <div class="title"><h1><span class="s1">Sorteo</span><span class="s2">Fin de Año</span></h1></div>
  <p class="sub">Acceso de agentes</p>
  <div class="panel">
    <label>Clave de agentes</label>
    <input id="claveIn" type="password" autocomplete="off" autocapitalize="characters" placeholder="Clave">
    <div class="hint" id="loginMsg"></div>
    <button class="btn" id="btnLogin">ENTRAR</button>
  </div>
</div>

<!-- APP -->
<div id="app" class="hidden">
  <div class="brand">MADAFAKER'S TEAM</div>
  <div class="title"><h1><span class="s1">Sorteo</span><span class="s2">Fin de Año</span></h1></div>
  <p class="sub" id="subtitulo"></p>

  <div class="cdcard">
    <h2 id="cdTitulo">⏳ Cuenta regresiva para el sorteo</h2>
    <div class="cd" id="cd">
      <div class="gift"><b id="cdD">--</b><small>Días</small></div>
      <div class="gift"><b id="cdH">--</b><small>Horas</small></div>
      <div class="gift"><b id="cdM">--</b><small>Minutos</small></div>
      <div class="gift"><b id="cdS">--</b><small>Segundos</small></div>
    </div>
    <div class="when" id="when">🎅 30 de diciembre · 20:00 hs</div>
  </div>

  <div class="stats">
    <div class="stat"><b id="sTotal">–</b><small>números entregados en total</small></div>
    <div class="stat"><b id="sHoy">–</b><small>números entregados hoy</small></div>
  </div>

  <div class="tabs">
    <button class="tab on" data-t="cargar">CARGAR</button>
    <button class="tab" data-t="lista">ÚLTIMOS</button>
    <button class="tab" data-t="buscar">BUSCAR</button>
    <button class="tab" data-t="sorteo">🔒 ADMIN</button>
  </div>

  <!-- CARGAR -->
  <div id="t-cargar">
    <div class="panel">
      <h2>Nueva carga</h2>
      <label>Nombre de la persona</label>
      <input id="fNombre" autocomplete="off" placeholder="Ej: María Pérez">
      <label>Nombre de usuario</label>
      <input id="fUsuario" autocomplete="off" autocapitalize="none" placeholder="Ej: mariaperez23">
      <label>Monto de la carga ($)</label>
      <input id="fMonto" inputmode="numeric" autocomplete="off" placeholder="Ej: 12000">
      <div class="hint" id="hintMonto"></div>
      <button class="btn" id="btnAdd">GENERAR TICKET</button>
    </div>
    <div id="resultado"></div>
  </div>

  <!-- ÚLTIMOS -->
  <div id="t-lista" class="hidden">
    <div class="panel"><h2>Últimas cargas</h2><div id="listaBox"><div class="empty">Cargando…</div></div></div>
  </div>

  <!-- BUSCAR -->
  <div id="t-buscar" class="hidden">
