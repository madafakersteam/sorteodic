<style>
:root{--black:#0A0A0A;--card:#161616;--line:#2a2a2a;--red:#D0102A;--red-light:#FF3B4E;--white:#F5F5F5;--gray:#9a9a9a;--green:#2ecc71;--gold:#f5c542}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{color:var(--white);font-family:'Inter',sans-serif;min-height:100vh;overflow-x:hidden;
  background:radial-gradient(ellipse at 50% -10%,#4a0a14 0%,transparent 60%),radial-gradient(ellipse at 50% 110%,#0b2a1a 0%,transparent 55%),#0A0A0A}
html{background:#0A0A0A}
#snow{position:fixed;inset:0;pointer-events:none;z-index:1}
.page{position:relative;z-index:3;max-width:560px;margin:0 auto;padding:6px 14px 150px}
.brand{text-align:center;color:var(--red-light);font-weight:800;letter-spacing:4px;font-size:12px}
.sub{text-align:center;color:var(--gray);font-size:12px;margin:2px 0 12px}
.cdcard{position:relative;border:1px solid var(--red);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:0 0 26px rgba(208,16,42,.3);
